# Docker Compose supplies these paths. No passwords or fallback credentials here.
APP_MODE=local
HOST=127.0.0.1
PORT=4000
CORS_ORIGINS=http://127.0.0.1:4000,http://localhost:4000
PGHOST=postgres
PGDATABASE=thebirthdates
PGUSER=birthday_app
PGPASSWORD_FILE=/run/secrets/db_app_password
PGSSLROOTCERT=/run/secrets/db_ca
SESSION_SECRET_FILE=/run/secrets/session_secret
# Production mode requires HTTPS and sets Secure cookies:
# HTTPS_KEY_FILE=/run/secrets/https_key
# HTTPS_CERT_FILE=/run/secrets/https_cert
